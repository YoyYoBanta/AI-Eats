# ==============================================================================
# AI-Powered Restaurant Recommendation System — Environment Configuration
# ==============================================================================
# Copy this file to `.env` and fill in the values before running the app.
#
#   cp .env.example .env
#
# NEVER commit your actual `.env` file to version control.
# ==============================================================================

# --- Hugging Face Dataset ---------------------------------------------------
# Dataset identifier on Hugging Face Hub
HF_DATASET_NAME=ManikaSaini/zomato-restaurant-recommendation

# --- LLM Provider (Groq) ----------------------------------------------------
# LLM provider — fixed to "groq" for this project
LLM_PROVIDER=groq

# Groq model identifier (see https://console.groq.com/docs/models)
LLM_MODEL=llama-3.3-70b-versatile

# Your Groq API key — obtain from https://console.groq.com/keys
GROQ_API_KEY=

# Groq API call timeout in seconds
LLM_TIMEOUT_SECONDS=30

# --- Recommendation Tuning --------------------------------------------------
# Maximum restaurants sent to the LLM context window
MAX_CANDIDATES=25

# Number of top recommendations returned to the user
TOP_K_RESULTS=5

# --- Budget Tier Thresholds (INR) --------------------------------------------
# Upper bound of the "low" budget tier (average cost for two)
BUDGET_LOW_MAX=500

# Upper bound of the "medium" budget tier (average cost for two)
BUDGET_MEDIUM_MAX=1500

# --- Feature Flags ----------------------------------------------------------
# Use rule-based fallback ranking when Groq call fails (true / false)
ENABLE_FALLBACK_RANKER=true
